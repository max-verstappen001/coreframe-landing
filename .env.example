# CoreFrame Landing — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── AI Chat Agent ───────────────────────────────
# Groq API key (FREE — recommended, uses Llama 3.3 70B)
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API key (optional — used if GROQ_API_KEY is not set)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ─── Notifications ───────────────────────────────
# Webhook URL to forward chat messages and contact form submissions
# Supports Slack, Discord, or any custom webhook endpoint
# Example Slack: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Example Discord: https://discord.com/api/webhooks/YOUR/WEBHOOK
WEBHOOK_URL=

# Email address for contact notifications (requires RESEND_API_KEY)
NOTIFICATION_EMAIL=

# Resend API key and verified sender
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Coreframe Website <send@coreframetech.in>

# Build each regional site separately: global (default) or uae
NEXT_PUBLIC_SITE_REGION=global
