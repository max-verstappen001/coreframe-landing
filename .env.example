# CoreFrame Landing — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── AI Chat Agent ───────────────────────────────
# OpenAI API key for the AI chat assistant
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ─── Notifications ───────────────────────────────
# Webhook URL to forward chat messages and contact form submissions
# Supports Slack, Discord, or any custom webhook endpoint
# Example Slack: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Example Discord: https://discord.com/api/webhooks/YOUR/WEBHOOK
WEBHOOK_URL=

# Email address for notifications (requires EMAIL_API_KEY)
NOTIFICATION_EMAIL=

# API key for email service (SendGrid, Resend, etc.)
EMAIL_API_KEY=
